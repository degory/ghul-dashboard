namespace Dashboard is
    use System.Exception

    use Collections.Iterable
    use Collections.LIST

    use IO.File
    use IO.Directory
    use IO.StreamReader

    // Reading the files the dashboard watches. Absent, unreadable and
    // half-written files all read as empty rather than throwing: these are other
    // programs' state files, read while they are being written, and a torn read
    // is normal rather than exceptional. The parsers treat empty input as no
    // data, so a bad read costs one stale frame.
    class FILES is
        read_text(path: string) -> string static is
            try
                return File.read_all_text(path)
            catch ex: Exception
                return ""
            yrt
        si

        // Only the end of a transcript is interesting and they grow to tens of
        // megabytes, so read a bounded window back from the end.
        read_tail(path: string, length: long) -> string static is
            try
                let stream = File.open_read(path)

                if stream.length > length then
                    stream.seek(stream.length - length, IO.SeekOrigin.BEGIN)
                fi

                let reader = StreamReader(stream)

                let text = reader.read_to_end()

                reader.dispose()

                return text
            catch ex: Exception
                return ""
            yrt
        si

        list(directory: string, pattern: string) -> Iterable[string] static is
            try
                if !Directory.exists(directory) then
                    return LIST[string]()
                fi

                return Directory.get_files(directory, pattern)
            catch ex: Exception
                return LIST[string]()
            yrt
        si

        list_directories(directory: string) -> Iterable[string] static is
            try
                if !Directory.exists(directory) then
                    return LIST[string]()
                fi

                return Directory.get_directories(directory)
            catch ex: Exception
                return LIST[string]()
            yrt
        si

        delete(path: string) static is
            try
                if File.exists(path) then
                    File.delete(path)
                fi
            catch ex: Exception
                return
            yrt
        si

        // The last path segment, which is the file or directory's own name.
        name_of(path: string) -> string static =>
            path.substring(path.last_index_of('/') + 1)
    si
si
