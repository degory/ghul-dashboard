namespace Dashboard is
    use Collections.Iterable;
    use Collections.LIST;

    use IO.Path;
    use IO.File;
    use IO.Directory;

    // The checkouts under the workspace, and the worktrees each of them has.
    //
    // One `git` invocation per checkout is too much to repeat every frame, and
    // worktrees come and go on a human timescale, so the answer is cached.
    class WORKTREE_SOURCE is
        refresh_interval_ms: long static => 10000L;

        _workspace: string;

        _worktrees: Iterable[WORKTREE];
        _collected_at: long;

        init(workspace: string) is
            _workspace = workspace;
            _worktrees = LIST[WORKTREE]();
        si

        collect(now: long) -> Iterable[WORKTREE] is
            if _collected_at > 0L /\ now - _collected_at < refresh_interval_ms then
                return _worktrees;
            fi

            let result = LIST[WORKTREE]();

            for repository in list_repositories() do
                let name = FILES.name_of(repository);

                let output = PROCESS_RUNNER.run("git", ["-C", repository, "worktree", "list", "--porcelain"]);

                for worktree in WORKTREE_LIST.parse(name, output) do
                    result.add(worktree);
                od
            od

            // A run that found nothing is more likely a transient `git` failure
            // than every checkout vanishing, so the previous answer stands.
            if result.count == 0 /\ _collected_at > 0L then
                return _worktrees;
            fi

            _worktrees = result;
            _collected_at = now;

            return result;
        si

        // Checkouts sit directly under the workspace. A worktree's `.git` is a
        // file pointing at the primary's, rather than a directory, so both
        // shapes count.
        list_repositories() -> Iterable[string] is
            let result = LIST[string]();

            for directory in FILES.list_directories(_workspace) do
                let marker = Path.join(directory, ".git");

                if Directory.exists(marker) \/ File.exists(marker) then
                    result.add(directory);
                fi
            od

            return result;
        si
    si
si
