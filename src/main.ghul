namespace Dashboard is
    use System.Exception;

    use IO.Std;
    use IO.Directory;
    use IO.File;
    use IO.Path;

    class Main is
        // Synchronous: an entry point has to return int or void, so the
        // collectors' tasks are driven from here rather than awaited.
        entry(arguments: string[]) -> int static is
            let interval mut = 1000;
            let once mut = false;

            let i mut = 0;

            while i < arguments.count do
                let argument = arguments[i];

                if argument =~ "--interval" then
                    i = i + 1;

                    if i >= arguments.count then
                        Std.write_line("--interval requires a value in seconds");
                        return 1;
                    fi

                    interval = cast int(double.parse(arguments[i]) * 1000.0D);
                elif argument =~ "--once" then
                    once = true;
                elif argument =~ "--help" \/ argument =~ "-h" then
                    write_usage();
                    return 0;
                else
                    Std.write_line("unknown argument: {argument}");
                    write_usage();
                    return 1;
                fi

                i = i + 1;
            od

            let workspace = find_workspace();

            if !workspace? then
                Std.write_line("not inside a ghūl workspace (no directory above holding CLAUDE.md and worktrees/)");
                return 1;
            fi

            let collector = COLLECTOR(workspace);

            let view = VIEW();

            if once then
                // Fitted to the terminal here too, so a piped frame matches
                // what the live view would have drawn.
                let sizing = SCREEN();

                view.width = sizing.width;
                view.height = sizing.height;

                let snapshot = collector.collect().result;

                collector.resolve_locations(snapshot.sessions, snapshot.worktrees);

                for line in RENDERER(view).render(snapshot) do
                    Std.write_line(line);
                od

                return 0;
            fi

            let screen = SCREEN();

            screen.enter();

            try
                do
                    let snapshot = collector.collect().result;

                    // Locations that need a transcript read are resolved after
                    // the first paint, so a cold start shows something at once.
                    collector.resolve_locations(snapshot.sessions, snapshot.worktrees);

                    let sessions = snapshot.sessions | .collect_list();

                    // A resize leaves the parts of the screen the new layout
                    // does not reach holding the old frame, so it is cleared
                    // before repainting at the new size.
                    if screen.width != view.width \/ screen.height != view.height then
                        view.width = screen.width;
                        view.height = screen.height;

                        screen.clear();
                    fi

                    if view.selected_pid == 0 /\ sessions.count > 0 then
                        view.selected_pid = sessions[0].pid;
                    fi

                    screen.paint(RENDERER(view).render(snapshot));

                    if handle_keys(screen, view, sessions, interval) then
                        break;
                    fi
                od
            catch ex: Exception
                screen.leave();
                Std.write_line("dashboard failed: {ex}");
                return 1;
            yrt

            screen.leave();

            return 0;
        si

        // Polls for keystrokes until the refresh period expires, so the frame
        // keeps its own cadence whether or not anything is typed. Returns true
        // when the user asked to quit.
        handle_keys(screen: SCREEN, view: VIEW, sessions: Collections.MutableList[SESSION], interval: int) -> bool static is
            let poll = 40;

            let waited mut = 0;

            while waited < interval do
                // One key per pass: each returns to repaint before the next is
                // read, so held-down arrows scroll at the refresh rate.
                if Std.key_available then
                    let key = Std.read_key(true);

                    // Ctrl-C arrives as input while the alternate screen is up,
                    // so it has to be handled rather than ending the process.
                    if
                        key.key_char == 'q' \/
                        key.key_char == cast char(3) \/
                        key.key == System.ConsoleKey.ESCAPE
                    then
                        return true;
                    elif key.key == System.ConsoleKey.UP_ARROW then
                        view.clear_pending_kill();
                        view.move(sessions, -1);
                        return false;
                    elif key.key == System.ConsoleKey.DOWN_ARROW then
                        view.clear_pending_kill();
                        view.move(sessions, 1);
                        return false;
                    elif key.key_char == cast char(12) then
                        // Ctrl-L: repaint from nothing, the conventional escape
                        // from a screen another program has scribbled on.
                        screen.clear();
                        return false;
                    elif key.key_char == 'k' then
                        request_kill(view, sessions);
                        return false;
                    elif view.pending_kill_pid > 0 /\ (key.key_char == 'y' \/ key.key_char == 'Y') then
                        confirm_kill(view);
                        return false;
                    elif view.pending_kill_pid > 0 then
                        view.clear_pending_kill();
                        view.message = null;
                        return false;
                    fi
                fi

                System.Threading.Thread.sleep(poll);

                waited = waited + poll;
            od

            return false;
        si

        request_kill(view: VIEW, sessions: Collections.MutableList[SESSION]) static is
            let session = view.get_selected(sessions);

            if !session? then
                view.message = "no session selected";
                return;
            fi

            // Terminating the session this dashboard is running under would
            // take the dashboard with it. That session is an ancestor rather
            // than this process, since it spawned us — and it is usually the
            // top row, being the most recently active.
            let candidates = Collections.SET[int]();

            candidates.add(session.pid);

            if SHELL.find_ancestor(System.Environment.process_id, candidates) > 0 then
                view.message = "that session is running this dashboard";
                return;
            fi

            view.pending_kill_pid = session.pid;
            view.message = null;
        si

        // SIGTERM rather than a kill: a session asked to stop can save its
        // transcript and exit cleanly, which SIGKILL would deny it.
        confirm_kill(view: VIEW) static is
            let pid = view.pending_kill_pid;

            view.clear_pending_kill();

            let output = SHELL.run("kill", ["-TERM", "{pid}"]).result;

            if string.is_null_or_white_space(output) then
                view.message = "sent SIGTERM to {pid}";
            else
                view.message = "kill {pid}: {output.trim()}";
            fi
        si

        // The workspace is the directory holding the per-repo checkouts. The
        // current directory is tried first, then the directory this program was
        // built into — which is inside the workspace however it was launched,
        // so running it from an unrelated shell still works.
        find_workspace() -> string? static is
            let override = System.Environment.get_environment_variable("GHUL_WORKSPACE");

            if !string.is_null_or_white_space(override) /\ Directory.exists(override) then
                return override;
            fi

            return
                find_workspace_above(System.Environment.current_directory) ??
                find_workspace_above(System.AppContext.base_directory);
        si

        find_workspace_above(start: string?) -> string? static is
            if string.is_null_or_white_space(start) then
                return null;
            fi

            let current mut = start!;

            let hops mut = 0;

            while hops < 16 do
                if File.exists(Path.join(current, "CLAUDE.md")) /\ Directory.exists(Path.join(current, "worktrees")) then
                    return current;
                fi

                let parent = Directory.get_parent(current);

                if !parent? then
                    return null;
                fi

                current = parent.full_name;

                hops = hops + 1;
            od

            return null;
        si

        write_usage() static is
            Std.write_line("usage: ghul-dashboard [--interval <seconds>] [--once]");
            Std.write_line("");
            Std.write_line("  Live view of Claude Code sessions, test runs and open pull requests");
            Std.write_line("  across the ghūl workspace. Press q to quit.");
        si
    si
si
