namespace Dashboard is
    use Collections.Iterable
    use Collections.MutableList
    use Collections.LIST

    // Composes a frame as plain lines. Kept apart from SCREEN so the layout can
    // be exercised without a terminal, and apart from LAYOUT so the arithmetic
    // can be checked without rendering.
    class RENDERER is
        minimum_width: int static => 40

        key_hints: string static => "up/down select   k kill session   ctrl-l redraw   q quit"

        _view: VIEW
        _width: int
        _now: long

        init(view: VIEW, now: long) is
            _view = view
            _now = now

            _width = view.width

            if _width < minimum_width then
                _width = minimum_width;
            fi
        si

        render(snapshot: SNAPSHOT) -> Iterable[string] is
            let lines = LIST[string]()

            let sessions = snapshot.sessions | .collect_list()
            let runs = snapshot.runs | .collect_list()
            let pull_requests = snapshot.pull_requests | .collect_list()

            let run_rows = get_run_rows(runs)
            let pull_request_rows = LAYOUT.get_capped(pull_requests.count, LAYOUT.maximum_pull_request_rows)
            let session_rows = LAYOUT.get_session_rows(_view.height, run_rows, pull_request_rows)

            render_header(lines, snapshot.system)
            render_sessions(lines, sessions, session_rows)
            render_runs(lines, runs, snapshot)
            render_pull_requests(lines, snapshot, pull_requests, pull_request_rows)
            render_footer(lines)

            return lines;
        si

        // Two rows per run — its heading and its bar — plus its in-flight tests.
        get_run_rows(runs: MutableList[RUN]) -> int static is
            let rows mut = 0

            for run in runs do
                rows = rows + 2 + LAYOUT.get_capped(run.running| .count(), LAYOUT.maximum_in_flight_rows);
            od

            if rows == 0 then
                return 1;
            fi

            return rows;
        si

        render_header(lines: MutableList[string], system: SYSTEM?) is
            let clock = SCREEN.dim(System.DateTime.now.to_string("HH:mm:ss"))

            if !system? then
                lines.add("{SCREEN.bold("ghul")} {clock}")
                lines.add("")
                return;
            fi

            let meter = LAYOUT.get_meter_width(_width)

            // Assembled in priority order and dropped from the end when the
            // window is too narrow, so the header never wraps: the meters are
            // what the panel is for, the load average and sizes are detail.
            let line = LINE_BUILDER(_width)

            line.try_append(4, SCREEN.bold("ghul"))
            line.try_append(9, " {clock}")

            append_meter(line, "cpu", system.processor_percent, meter)
            append_meter(line, "mem", system.memory_percent, meter)

            let cores = system.core_percents| .count()

            line.try_append(
                16,
                SCREEN.dim("  load {system.load_average.to_string("0.00")}/{cores}")
            )

            let sizes = "{FORMAT.size(system.memory_used_kb)}/{FORMAT.size(system.memory_total_kb)}"

            line.try_append(sizes.length + 2, SCREEN.dim("  {sizes}"))

            lines.add(line.to_string())

            lines.add(render_cores_and_busiest(system));
        si

        // A labelled meter and its percentage. With no room for a bar the
        // percentage still goes in, which is the part that carries the number.
        append_meter(line: LINE_BUILDER, label: string, percent: double, meter: int) static is
            if meter > 0 then
                line.try_append(
                    LAYOUT.header_label_width + meter + LAYOUT.header_percent_width,
                    "  {label} {METER.painted_bar(percent, meter)} {FORMAT.percent(percent)}"
                )

                return;
            fi

            line.try_append(
                LAYOUT.header_label_width + LAYOUT.header_percent_width,
                "  {label} {METER.paint(FORMAT.percent(percent), percent)}"
            );
        si

        // Per-core cells give away a single pegged core that an average hides;
        // the busiest processes say what is doing it.
        render_cores_and_busiest(system: SYSTEM) -> string is
            let cores = System.Text.StringBuilder()

            for percent in system.core_percents do
                cores.append(METER.core_cell(percent));
            od

            let busiest = System.Text.StringBuilder()

            for load in system.top do
                if busiest.length > 0 then
                    busiest.append("  ");
                fi

                busiest.append("{load.name} {load.processor_percent.to_string("0")}%");
            od

            if system.swap_used_kb > 0L then
                busiest.append("  swap {FORMAT.size(system.swap_used_kb)}");
            fi

            let detail = SCREEN.clip(busiest.to_string(), _width - system.core_percents.count - 8)

            return "  {SCREEN.dim("[")}{cores.to_string()}{SCREEN.dim("]")}  {SCREEN.dim(detail)}";
        si

        heading(lines: MutableList[string], text: string, detail: string?) is
            if detail? then
                lines.add("{SCREEN.bold(text)} {SCREEN.dim(detail)}");
            else
                lines.add(SCREEN.bold(text));
            fi
        si

        render_sessions(lines: MutableList[string], sessions: MutableList[SESSION], rows: int) is
            heading(lines, "sessions", get_overflow_detail(sessions.count, rows, "total"))

            if sessions.count == 0 then
                lines.add("  {SCREEN.dim("none")}")
                return;
            fi

            // The window follows the selection, so it can never scroll out of
            // sight.
            let selected = _view.get_selected_index(sessions)

            let first mut = 0

            if selected >= rows then
                first = selected - rows + 1;
            fi

            let index mut = first
            let shown mut = 0

            while index < sessions.count /\ shown < rows do
                lines.add(format_session(sessions[index], index == selected))

                index = index + 1
                shown = shown + 1;
            od

            add_overflow(lines, sessions.count - index);
        si

        get_overflow_detail(count: int, rows: int, noun: string) -> string? static is
            if count > rows then
                return "{count} {noun}";
            fi

            return null;
        si

        add_overflow(lines: MutableList[string], remaining: int) static is
            if remaining > 0 then
                lines.add("  {SCREEN.dim("+{remaining} more")}");
            fi
        si

        // A selected row is drawn in reverse video with no per-field colour: an
        // inner colour reset would end the highlight partway across.
        format_session(session: SESSION, selected: bool) -> string is
            let columns = LAYOUT.get_session_columns(_width)

            let kind = if session.is_background then "bg "; else "   "; fi

            let age = FORMAT.age(session.status_updated_at, _now).pad_left(LAYOUT.session_age_width)

            let name = SCREEN.pad(session.name, columns.name)
            let where = SCREEN.pad(session.where ?? "-", columns.where)
            let status = SCREEN.pad(session.status, LAYOUT.session_status_width)

            if selected then
                return SCREEN.reverse(SCREEN.pad("> {name} {kind} {status} {where} {age}", _width));
            fi

            let marker mut = SCREEN.dim("-")
            let painted_status mut = SCREEN.dim(status)

            if session.status? /\ session.status =~ "busy" then
                marker = SCREEN.yellow("*")
                painted_status = SCREEN.yellow(status);
            elif session.status? /\ session.status =~ "shell" then
                marker = SCREEN.cyan("*")
                painted_status = SCREEN.cyan(status);
            fi

            let painted_where =
                if session.where? then
                    SCREEN.blue(where);
                else
                    SCREEN.dim(where);
                fi

            return "{marker} {name} {SCREEN.dim(kind)} {painted_status} {painted_where} {SCREEN.dim(age)}";
        si

        render_runs(lines: MutableList[string], runs: MutableList[RUN], snapshot: SNAPSHOT) is
            lines.add("")

            heading(lines, "test runs", null)

            if runs.count == 0 then
                lines.add("  {SCREEN.dim("none in progress")}")
                return;
            fi

            for run in runs do
                let where = describe_run_location(run, snapshot)

                let suites = SCREEN.dim(run.suites| .to_string(" "))
                let elapsed = SCREEN.dim("{run.elapsed_seconds}s")

                lines.add("  {SCREEN.bold(where)}  {suites}  {elapsed}")

                lines.add("    {format_run_bar(run)}")

                for test in run.running | .take(LAYOUT.maximum_in_flight_rows) do
                    lines.add("      {SCREEN.dim(SCREEN.clip(test, _width - 6))}");
                od
            od
        si

        describe_run_location(run: RUN, snapshot: SNAPSHOT) -> string static is
            for worktree in snapshot.worktrees do
                if run.cwd =~ worktree.path then
                    return worktree.label;
                fi
            od

            return FILES.name_of(run.cwd);
        si

        format_run_bar(run: RUN) -> string is
            let width = LAYOUT.get_capped(_width / 3, LAYOUT.maximum_meter_width + 8)

            let percent = cast double(run.percent)

            let body = "{METER.bar(percent, width)} {FORMAT.percent(percent)}  {run.completed}/{run.total}"

            let painted =
                if run.failed > 0 then
                    SCREEN.red(body);
                elif run.is_done then
                    SCREEN.green(body);
                else
                    SCREEN.yellow(body);
                fi

            let detail = System.Text.StringBuilder()

            detail.append("  {SCREEN.green("pass {run.passed}")}")

            if run.failed > 0 then
                detail.append("  {SCREEN.red("fail {run.failed}")}");
            fi

            if run.skipped > 0 then
                detail.append("  {SCREEN.dim("skip {run.skipped}")}");
            fi

            if run.is_done then
                detail.append("  {SCREEN.dim("done")}");
            fi

            return "{painted}{detail.to_string()}";
        si

        render_pull_requests(
            lines: MutableList[string],
            snapshot: SNAPSHOT,
            pull_requests: MutableList[PULL_REQUEST],
            rows: int
        ) is
            lines.add("")

            heading(lines, "pull requests", get_overflow_detail(pull_requests.count, rows, "open"))

            if snapshot.pull_requests_fetched_at == 0L then
                lines.add("  {SCREEN.dim("fetching...")}")
                return;
            fi

            if pull_requests.count == 0 then
                lines.add("  {SCREEN.dim("none open")}")
                return;
            fi

            let index mut = 0

            while index < pull_requests.count /\ index < rows do
                lines.add(format_pull_request(pull_requests[index]))

                index = index + 1;
            od

            add_overflow(lines, pull_requests.count - index);
        si

        format_pull_request(pull_request: PULL_REQUEST) -> string is
            let marker mut = SCREEN.yellow("*")

            if pull_request.is_bad then
                marker = SCREEN.red("!");
            elif pull_request.is_good then
                marker = SCREEN.green("+");
            fi

            let columns = LAYOUT.get_pull_request_columns(_width)

            let line = LINE_BUILDER(_width)

            line.try_append(LAYOUT.pull_request_indent + LAYOUT.pull_request_marker_width, "  {marker}")

            if columns.repository > 0 then
                line.try_append(
                    columns.repository + 1,
                    " {SCREEN.dim(SCREEN.pad(pull_request.repository, columns.repository))}"
                );
            fi

            line.try_append(
                LAYOUT.pull_request_number_width + 1,
                " {SCREEN.pad("#{pull_request.number}", LAYOUT.pull_request_number_width)}"
            )

            line.try_append(columns.branch + 1, " {SCREEN.pad(pull_request.branch, columns.branch)}")

            if columns.checks > 0 then
                line.try_append(columns.checks + 1, " {format_checks(pull_request.checks, columns.checks)}");
            fi

            line.try_append(columns.review + 1, " {format_review(pull_request.review, columns.review)}")

            return line.to_string();
        si

        format_checks(state: string, width: int) -> string static is
            if state =~ "SUCCESS" then
                return SCREEN.green(SCREEN.pad("ci ok", width));
            elif state =~ "FAILURE" \/ state =~ "ERROR" then
                return SCREEN.red(SCREEN.pad("ci fail", width));
            elif state =~ "PENDING" then
                return SCREEN.yellow(SCREEN.pad("ci ...", width));
            fi

            return SCREEN.dim(SCREEN.pad("ci -", width));
        si

        format_review(decision: string, width: int) -> string static is
            if decision =~ "APPROVED" then
                return SCREEN.green(SCREEN.pad("approved", width));
            elif decision =~ "CHANGES_REQUESTED" then
                return SCREEN.red(SCREEN.pad("changes", width));
            fi

            return SCREEN.yellow(SCREEN.pad("pending", width));
        si

        // The footer carries the key hints, unless a confirmation is pending —
        // that replaces them, so the question cannot be missed.
        render_footer(lines: MutableList[string]) is
            lines.add("")

            if _view.pending_kill_pid > 0 then
                lines.add(SCREEN.red(SCREEN.clip("terminate session {_view.pending_kill_pid}?  y / n", _width)))
                return;
            fi

            if _view.message? then
                lines.add(SCREEN.yellow(SCREEN.clip(_view.message, _width)))
                return;
            fi

            // Clipped like everything else: the hints are the longest fixed
            // string in the frame, so a narrow window would wrap on them.
            lines.add(SCREEN.dim(SCREEN.clip(key_hints, _width)));
        si
    si
si
