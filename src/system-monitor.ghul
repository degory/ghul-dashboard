namespace Dashboard is
    use System.Exception;

    use Collections.Iterable;
    use Collections.MutableList;
    use Collections.MutableMap;
    use Collections.LIST;
    use Collections.MAP;

    use IO.File;
    use IO.Directory;

    // One /proc/stat CPU line reduced to the two totals a utilisation ratio
    // needs. Absolute values are meaningless on their own — utilisation is the
    // ratio of their growth between two samples.
    class CPU_TIMES is
        busy: long;
        total: long;

        init(busy: long, total: long) is
            self.busy = busy;
            self.total = total;
        si
    si

    // Samples CPU, memory and per-process load from /proc. Retains the previous
    // sample because every CPU figure here is a delta: a first sample can only
    // report memory, and utilisation appears from the second frame onwards.
    class SYSTEM_MONITOR is
        // The kernel reports process times in USER_HZ, which is 100 on every
        // Linux configuration this runs on.
        ticks_per_second: double => 100.0D;

        _previous_overall: CPU_TIMES?;
        _previous_cores: MutableList[CPU_TIMES];
        _previous_process_ticks: MutableMap[int,long];
        _previous_at: long;

        // The shortest delta worth reporting. A window much below this is
        // mostly sampling noise, and one frame of it would read as a spike.
        minimum_window_ms: long => 200L;

        init() is
            _previous_cores = LIST[CPU_TIMES]();
            _previous_process_ticks = MAP[int,long]();

            // Primed at construction so the very first frame has a baseline to
            // subtract from, rather than reporting an idle machine.
            let baseline = SYSTEM();

            read_processor_times(baseline);
            read_top_processes(baseline, 0.0D);

            _previous_at = System.DateTimeOffset.utc_now.to_unix_time_milliseconds();
        si

        sample() -> SYSTEM is
            let result = SYSTEM();

            let since = System.DateTimeOffset.utc_now.to_unix_time_milliseconds() - _previous_at;

            if since < minimum_window_ms then
                System.Threading.Thread.sleep(cast int(minimum_window_ms - since));
            fi

            let now = System.DateTimeOffset.utc_now.to_unix_time_milliseconds();

            let elapsed_seconds =
                if _previous_at > 0L then
                    cast double(now - _previous_at) / 1000.0D;
                else
                    0.0D;
                fi;

            read_processor_times(result);
            read_memory(result);
            read_load_average(result);
            read_top_processes(result, elapsed_seconds);

            _previous_at = now;

            return result;
        si

        read_processor_times(result: SYSTEM) is
            let overall_line mut = "";
            let core_lines = LIST[string]();

            for line in SHELL.lines(SHELL.read_text("/proc/stat")) do
                if line.starts_with("cpu ") then
                    overall_line = line;
                elif line.starts_with("cpu") then
                    core_lines.add(line);
                fi
            od

            let overall = parse_processor_times(overall_line);

            if overall? then
                result.processor_percent = get_percent(_previous_overall, overall);
                _previous_overall = overall;
            fi

            let percents = LIST[double]();

            let index mut = 0;

            for line in core_lines do
                let times = parse_processor_times(line);

                if !times? then
                    continue;
                fi

                let previous =
                    if index < _previous_cores.count then
                        _previous_cores[index];
                    else
                        null;
                    fi;

                percents.add(get_percent(previous, times));

                if index < _previous_cores.count then
                    _previous_cores[index] = times;
                else
                    _previous_cores.add(times);
                fi

                index = index + 1;
            od

            result.core_percents = percents | .collect_array();
        si

        // Fields are user nice system idle iowait irq softirq steal ...; time
        // spent idle or waiting on I/O is not the processor being busy.
        parse_processor_times(line: string) -> CPU_TIMES? static is
            if string.is_null_or_empty(line) then
                return null;
            fi

            let fields = line.split([' ']);

            let total mut = 0L;
            let idle mut = 0L;

            let index mut = 0;

            for part in fields do
                if string.is_null_or_empty(part) \/ part.starts_with("cpu") then
                    continue;
                fi

                let value = parse_long(part);

                total = total + value;

                if index == 3 \/ index == 4 then
                    idle = idle + value;
                fi

                index = index + 1;
            od

            if total == 0L then
                return null;
            fi

            return CPU_TIMES(total - idle, total);
        si

        get_percent(previous: CPU_TIMES?, current: CPU_TIMES) -> double static is
            if !previous? then
                return 0.0D;
            fi

            let total = current.total - previous.total;

            if total <= 0L then
                return 0.0D;
            fi

            let busy = current.busy - previous.busy;

            return clamp_percent(cast double(busy) * 100.0D / cast double(total));
        si

        read_memory(result: SYSTEM) static is
            for line in SHELL.lines(SHELL.read_text("/proc/meminfo")) do
                if line.starts_with("MemTotal:") then
                    result.memory_total_kb = parse_meminfo_value(line);
                elif line.starts_with("MemAvailable:") then
                    result.memory_available_kb = parse_meminfo_value(line);
                elif line.starts_with("SwapTotal:") then
                    result.swap_total_kb = parse_meminfo_value(line);
                elif line.starts_with("SwapFree:") then
                    result.swap_free_kb = parse_meminfo_value(line);
                fi
            od
        si

        // `MemTotal:       16364728 kB` — the value is the second part.
        parse_meminfo_value(line: string) -> long static is
            for part in line.split([' ']) do
                if string.is_null_or_empty(part) \/ part.ends_with(":") \/ part =~ "kB" then
                    continue;
                fi

                return parse_long(part);
            od

            return 0L;
        si

        read_load_average(result: SYSTEM) static is
            let fields = SHELL.read_text("/proc/loadavg").split([' ']);

            if fields.count > 0 then
                result.load_average = parse_double(fields[0]);
            fi
        si

        // Per-process utilisation, as a share of one core, so a figure above
        // 100 means a process is spread over more than one.
        read_top_processes(result: SYSTEM, elapsed_seconds: double) is
            let current_ticks = MAP[int,long]();

            let loads = LIST[PROCESS_LOAD]();

            for directory in Directory.get_directories("/proc") do
                let name = directory.substring(directory.last_index_of('/') + 1);

                if !is_all_digits(name) then
                    continue;
                fi

                let pid = cast int(parse_long(name));

                // A process can exit between the listing and the read.
                let text = SHELL.read_text("{directory}/stat");

                if string.is_null_or_empty(text) then
                    continue;
                fi

                let close = text.last_index_of(')');
                let open = text.index_of('(');

                if close < 0 \/ open < 0 \/ close < open then
                    continue;
                fi

                let command = text.substring(open + 1, close - open - 1);

                let fields = text.substring(close + 1).trim().split([' ']);

                // Fields after the command, zero-based: 11 utime, 12 stime,
                // 21 rss in pages.
                if fields.count < 22 then
                    continue;
                fi

                let ticks = parse_long(fields[11]) + parse_long(fields[12]);

                current_ticks[pid] = ticks;

                if elapsed_seconds <= 0.0D \/ !_previous_process_ticks.contains_key(pid) then
                    continue;
                fi

                let delta = ticks - _previous_process_ticks[pid];

                if delta <= 0L then
                    continue;
                fi

                let percent = cast double(delta) * 100.0D / (ticks_per_second * elapsed_seconds);

                loads.add(PROCESS_LOAD(pid, command, percent, parse_long(fields[21]) * 4L));
            od

            _previous_process_ticks = current_ticks;

            result.top = take_busiest(loads, 3);
        si

        // Selection sort over the first `count`: the list runs to hundreds of
        // entries and only a handful are ever shown.
        take_busiest(loads: MutableList[PROCESS_LOAD], count: int) -> Iterable[PROCESS_LOAD] static is
            let result = LIST[PROCESS_LOAD]();

            let taken = LIST[bool]();

            for load in loads do
                taken.add(false);
            od

            let wanted mut = count;

            if wanted > loads.count then
                wanted = loads.count;
            fi

            let picked mut = 0;

            while picked < wanted do
                let best mut = -1;

                let index mut = 0;

                while index < loads.count do
                    if !taken[index] /\ (best < 0 \/ loads[index].processor_percent > loads[best].processor_percent) then
                        best = index;
                    fi

                    index = index + 1;
                od

                if best < 0 then
                    break;
                fi

                taken[best] = true;
                result.add(loads[best]);

                picked = picked + 1;
            od

            return result;
        si

        is_all_digits(text: string) -> bool static is
            if string.is_null_or_empty(text) then
                return false;
            fi

            for c in text do
                if !char.is_digit(c) then
                    return false;
                fi
            od

            return true;
        si

        clamp_percent(value: double) -> double static is
            if value < 0.0D then
                return 0.0D;
            elif value > 100.0D then
                return 100.0D;
            fi

            return value;
        si

        parse_long(text: string) -> long static is
            try
                return long.parse(text);
            catch ex: Exception
                return 0L;
            yrt
        si

        parse_double(text: string) -> double static is
            try
                return double.parse(text);
            catch ex: Exception
                return 0.0D;
            yrt
        si
    si
si
