namespace Dashboard is
    use Collections.Iterable
    use Collections.LIST

    // Parsers for the /proc files the dashboard reads. Each takes the file's
    // contents as a string and returns data, so none of them needs a machine to
    // read — which is what makes them worth testing.

    // One /proc/stat CPU line reduced to the two totals a utilisation ratio
    // needs. The absolute values mean nothing on their own: utilisation is the
    // ratio of their growth between two samples.
    class PROCESSOR_TIMES is
        busy: long
        total: long

        init(busy: long, total: long) is
            self.busy = busy
            self.total = total;
        si

        // Columns are user nice system idle iowait irq softirq steal ...; time
        // spent idle or waiting on I/O is not the processor being busy. Returns
        // null for a line that is not a CPU line.
        parse(line: string?) -> PROCESSOR_TIMES? static is
            let columns = TEXT.words(line) | .collect_list()

            if columns.count < 5 \/ !columns[0].starts_with("cpu") then
                return null;
            fi

            let total mut = 0L
            let idle mut = 0L

            let index mut = 1

            while index < columns.count do
                let value = TEXT.to_long(columns[index])

                total = total + value

                // Columns four and five, counting the label, are idle and
                // iowait.
                if index == 4 \/ index == 5 then
                    idle = idle + value;
                fi

                index = index + 1;
            od

            if total == 0L then
                return null;
            fi

            return PROCESSOR_TIMES(total - idle, total);
        si

        // Utilisation over the interval between two samples. Zero when there is
        // no previous sample, when no time passed, or when the counters went
        // backwards — which happens if a core is hotplugged.
        percent_since(previous: PROCESSOR_TIMES?) -> double is
            if !previous? then
                return 0.0D;
            fi

            let elapsed = total - previous.total

            if elapsed <= 0L then
                return 0.0D;
            fi

            let worked = busy - previous.busy

            if worked <= 0L then
                return 0.0D;
            fi

            let percent = cast double(worked) * 100.0D / cast double(elapsed)

            if percent > 100.0D then
                return 100.0D;
            fi

            return percent;
        si

        // Every CPU line in /proc/stat: the aggregate first, then one per core.
        parse_all(text: string?) -> Iterable[PROCESSOR_TIMES] static is
            let result = LIST[PROCESSOR_TIMES]()

            for line in TEXT.lines(text) do
                let times = parse(line)

                if times? then
                    result.add(times);
                fi
            od

            return result;
        si
    si

    class MEMORY_INFO is
        total_kb: long public
        available_kb: long public
        swap_total_kb: long public
        swap_free_kb: long public

        used_kb: long => total_kb - available_kb
        swap_used_kb: long => swap_total_kb - swap_free_kb

        init() is si

        // Lines read `MemTotal:       16364728 kB`, so the value is the second
        // word.
        parse(text: string?) -> MEMORY_INFO static is
            let result = MEMORY_INFO()

            for line in TEXT.lines(text) do
                let words = TEXT.words(line) | .collect_list()

                if words.count < 2 then
                    continue;
                fi

                let value = TEXT.to_long(words[1])

                if words[0] =~ "MemTotal:" then
                    result.total_kb = value;
                elif words[0] =~ "MemAvailable:" then
                    result.available_kb = value;
                elif words[0] =~ "SwapTotal:" then
                    result.swap_total_kb = value;
                elif words[0] =~ "SwapFree:" then
                    result.swap_free_kb = value;
                fi
            od

            return result;
        si
    si

    class LOAD_AVERAGE is
        // The one-minute figure, the first of the five columns.
        parse(text: string?) -> double static is
            let words = TEXT.words(text) | .collect_list()

            if words.count == 0 then
                return 0.0D;
            fi

            return TEXT.to_double(words[0]);
        si
    si

    // A /proc/<pid>/stat line. The command sits in parentheses and can itself
    // contain spaces and parentheses — `(Web Content)`, `(foo) bar (baz)` — so
    // the numeric columns are read from after the *last* closing parenthesis
    // rather than by splitting the whole line.
    class PROCESS_STAT is
        command: string
        parent_pid: int
        processor_ticks: long

        init(command: string, parent_pid: int, processor_ticks: long) is
            self.command = command
            self.parent_pid = parent_pid
            self.processor_ticks = processor_ticks;
        si

        parse(text: string?) -> PROCESS_STAT? static is
            if string.is_null_or_empty(text) then
                return null;
            fi

            let open = text!.index_of('(')
            let close = text.last_index_of(')')

            if open < 0 \/ close < open then
                return null;
            fi

            let command = text.substring(open + 1, close - open - 1)

            // Counting from the column after the command: state, ppid, ...,
            // then utime and stime.
            let columns = TEXT.words(text.substring(close + 1)) | .collect_list()

            if columns.count < 13 then
                return null;
            fi

            return
                PROCESS_STAT(
                    command,
                    TEXT.to_int(columns[1]),
                    TEXT.to_long(columns[11]) + TEXT.to_long(columns[12])
                );
        si
    si
si
