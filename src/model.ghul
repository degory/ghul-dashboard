namespace Dashboard is
    use Collections.Iterable;

    // ghul-test's run status file. The shape is a wire contract shared with
    // the writer, so `version` gates any incompatible change to it.
    class RUN is
        version: int public;

        pid: int public;
        cwd: string public;
        suites: string[] public;

        state: string? public;

        started_at: long public;
        updated_at: long public;

        total: int public;
        completed: int public;
        passed: int public;
        failed: int public;
        skipped: int public;
        percent: int public;

        running: string[] public;
        last: string? public;

        is_done: bool => state? /\ state =~ "done";

        elapsed_seconds: int => cast int((updated_at - started_at) / 1000L);

        init() is si
    si

    // Claude Code's per-process session record. Wire names are camelCase, so
    // this is deserialized with the camel-case naming policy.
    class SESSION is
        pid: int public;
        session_id: string? public;
        cwd: string? public;
        started_at: long public;
        version: string? public;
        kind: string? public;
        name: string? public;
        status: string? public;
        status_updated_at: long public;
        job_id: string? public;

        // Filled in from the process tree and transcript, not the wire.
        where: string? public;

        is_background: bool => kind? /\ kind =~ "bg";

        init() is si
    si

    class WORKTREE is
        path: string;
        repository: string;
        branch: string;

        slug: string => path.substring(path.last_index_of('/') + 1);

        // A primary checkout's directory is the repository name, so naming it
        // <repo>/<slug> would say the same word twice.
        label: string =>
            if slug =~ repository then
                repository;
            else
                "{repository}/{slug}";
            fi;

        init(repository: string, path: string, branch: string) is
            self.repository = repository;
            self.path = path;
            self.branch = branch;
        si
    si

    class PULL_REQUEST is
        number: int;
        branch: string;
        repository: string;
        review: string;
        checks: string;

        is_bad: bool => review =~ "CHANGES_REQUESTED" \/ checks =~ "FAILURE" \/ checks =~ "ERROR";
        is_good: bool => review =~ "APPROVED" /\ (checks =~ "SUCCESS" \/ checks =~ "NONE");

        init(number: int, branch: string, repository: string, review: string, checks: string) is
            self.number = number;
            self.branch = branch;
            self.repository = repository;
            self.review = review;
            self.checks = checks;
        si
    si

    // Everything one frame draws, collected together so a redraw cannot mix
    // two generations of data.
    class SNAPSHOT is
        sessions: Iterable[SESSION];
        runs: Iterable[RUN];
        worktrees: Iterable[WORKTREE];
        pull_requests: Iterable[PULL_REQUEST];

        // Null until the first successful fetch; the pull-request panel says
        // so rather than showing an empty list as though there were none.
        pull_requests_fetched_at: long public;

        init(
            sessions: Iterable[SESSION],
            runs: Iterable[RUN],
            worktrees: Iterable[WORKTREE],
            pull_requests: Iterable[PULL_REQUEST]
        ) is
            self.sessions = sessions;
            self.runs = runs;
            self.worktrees = worktrees;
            self.pull_requests = pull_requests;
        si
    si
si
