namespace Tests is
    use Dashboard;

    class WORKTREE_LIST_TESTS is
        @test()

        init() is si

        porcelain: string static =>
            "worktree /w/ghul\nHEAD abc123\nbranch refs/heads/main\n\nworktree /w/worktrees/ghul/fix\nHEAD def456\nbranch refs/heads/claude/fix\n";

        worktree_list__parse__reads_a_worktree_per_paragraph() is
            @test()

            let worktrees = WORKTREE_LIST.parse("ghul", porcelain) | .collect_list();

            are_equal(2, worktrees.count);
            are_equal("/w/ghul", worktrees[0].path);
            are_equal("main", worktrees[0].branch);
            are_equal("claude/fix", worktrees[1].branch);
        si

        worktree_list__parse__given_a_detached_worktree__names_it_as_detached() is
            @test()

            let worktrees =
                WORKTREE_LIST.parse("ghul", "worktree /w/x\nHEAD abc123\ndetached\n") | .collect_list();

            are_equal(1, worktrees.count);
            are_equal(WORKTREE_LIST.detached_branch, worktrees[0].branch);
        si

        worktree_list__parse__given_empty_input__finds_nothing() is
            @test()

            are_equal(0, WORKTREE_LIST.parse("ghul", "")| .count());
        si

        // The primary checkout's directory is the repository name, so labelling
        // it <repo>/<slug> would say the same word twice.
        worktree__label__names_a_primary_checkout_once() is
            @test()

            are_equal("ghul", WORKTREE("ghul", "/w/ghul", "main").label);
        si

        worktree__label__names_a_worktree_by_repository_and_slug() is
            @test()

            are_equal("ghul/fix", WORKTREE("ghul", "/w/worktrees/ghul/fix", "claude/fix").label);
        si
    si

    class PULL_REQUEST_ROWS_TESTS is
        @test()

        init() is si

        rows: string static =>
            "1771\tclaude/docs\tghul\tAPPROVED\tSUCCESS\n136\tclaude/progress\tghul-test\tNONE\tPENDING\n";

        pull_request_rows__parse__reads_a_pull_request_per_row() is
            @test()

            let pull_requests = PULL_REQUEST_ROWS.parse(rows) | .collect_list();

            are_equal(2, pull_requests.count);
            are_equal(1771, pull_requests[0].number);
            are_equal("claude/docs", pull_requests[0].branch);
            are_equal("ghul", pull_requests[0].repository);
            are_equal("APPROVED", pull_requests[0].review);
            are_equal("SUCCESS", pull_requests[0].checks);
        si

        // The dashboard watches this session's work, and a human's own branches
        // are not that.
        pull_request_rows__parse__keeps_only_claude_branches() is
            @test()

            let pull_requests =
                PULL_REQUEST_ROWS.parse("1\tmain\tghul\tNONE\tSUCCESS\n2\tclaude/x\tghul\tNONE\tSUCCESS\n")
                    | .collect_list();

            are_equal(1, pull_requests.count);
            are_equal(2, pull_requests[0].number);
        si

        // A short row is a truncated response, not a pull request with missing
        // fields.
        pull_request_rows__parse__skips_rows_with_too_few_columns() is
            @test()

            are_equal(0, PULL_REQUEST_ROWS.parse("1\tclaude/x\tghul")| .count());
        si

        pull_request_rows__parse__given_empty_input__finds_nothing() is
            @test()

            are_equal(0, PULL_REQUEST_ROWS.parse("")| .count());
        si

        pull_request__is_bad__holds_for_a_failed_check_or_requested_changes() is
            @test()

            is_true(PULL_REQUEST(1, "claude/x", "ghul", "NONE", "FAILURE").is_bad);
            is_true(PULL_REQUEST(1, "claude/x", "ghul", "CHANGES_REQUESTED", "SUCCESS").is_bad);
            is_false(PULL_REQUEST(1, "claude/x", "ghul", "APPROVED", "SUCCESS").is_bad);
        si

        // A repository with no checks configured reports NONE, which should not
        // read as a failure.
        pull_request__is_good__holds_for_approved_with_passing_or_absent_checks() is
            @test()

            is_true(PULL_REQUEST(1, "claude/x", "ghul", "APPROVED", "SUCCESS").is_good);
            is_true(PULL_REQUEST(1, "claude/x", "ghul", "APPROVED", "NONE").is_good);
            is_false(PULL_REQUEST(1, "claude/x", "ghul", "APPROVED", "PENDING").is_good);
        si
    si

    class TEXT_TESTS is
        @test()

        init() is si

        text__lines__drops_blank_lines_and_carriage_returns() is
            @test()

            let lines = TEXT.lines("one\r\n\ntwo\n\n") | .collect_list();

            are_equal(2, lines.count);
            are_equal("one", lines[0]);
            are_equal("two", lines[1]);
        si

        text__words__collapses_runs_of_spaces() is
            @test()

            let words = TEXT.words("  a   b\tc ") | .collect_list();

            are_equal(3, words.count);
            are_equal("a", words[0]);
            are_equal("c", words[2]);
        si

        // These read machine-generated files, where a torn read is normal and
        // not worth a crash.
        text__to_long__given_input_that_is_not_a_number__is_zero() is
            @test()

            are_equal(0L, TEXT.to_long("banana"));
            are_equal(0L, TEXT.to_long(null));
            are_equal(42L, TEXT.to_long("42"));
        si
    si
si
