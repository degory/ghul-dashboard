namespace Tests is
    use Dashboard;

    class FORMAT_TESTS is
        @test()

        init() is si

        // A realistic epoch millisecond value: ages are computed by subtraction,
        // so a small stand-in puts the timestamps before the epoch.
        now: long static => 1784969222541L;

        format__age__reads_in_seconds_then_minutes_then_hours() is
            @test()

            are_equal("30s", FORMAT.age(now - 30000L, now));
            are_equal("5m", FORMAT.age(now - 300000L, now));
            are_equal("2h", FORMAT.age(now - 7200000L, now));
        si

        format__age__switches_unit_on_the_boundary() is
            @test()

            are_equal("59s", FORMAT.age(now - 59000L, now));
            are_equal("1m", FORMAT.age(now - 60000L, now));
            are_equal("59m", FORMAT.age(now - 3599000L, now));
            are_equal("1h", FORMAT.age(now - 3600000L, now));
        si

        // A zero timestamp means the session never reported a status, which
        // reads better as nothing than as a number.
        format__age__given_no_timestamp__is_empty() is
            @test()

            are_equal("", FORMAT.age(0L, now));
        si

        // Clocks move. A timestamp from the future should not render as a
        // negative age.
        format__age__given_a_future_timestamp__is_empty() is
            @test()

            are_equal("", FORMAT.age(now + 5000L, now));
        si

        format__size__scales_from_kilobytes_to_gigabytes() is
            @test()

            are_equal("512K", FORMAT.size(512L));
            are_equal("2M", FORMAT.size(2048L));
            are_equal("1.0G", FORMAT.size(1048576L));
            are_equal("15.6G", FORMAT.size(16364728L));
        si

        format__percent__is_padded_so_columns_line_up() is
            @test()

            are_equal("  0%", FORMAT.percent(0.0D));
            are_equal(" 42%", FORMAT.percent(41.6D));
            are_equal("100%", FORMAT.percent(100.0D));
        si

        format__ratio__given_a_zero_denominator__is_zero() is
            @test()

            are_close(0.0D, FORMAT.ratio(5L, 0L), 0.001D);
            are_close(50.0D, FORMAT.ratio(5L, 10L), 0.001D);
        si
    si

    class METER_TESTS is
        @test()

        init() is si

        meter__bar__fills_in_proportion_to_the_percentage() is
            @test()

            are_equal("#####.....", METER.bar(50.0D, 10));
            are_equal("###.......", METER.bar(30.0D, 10));
            are_equal("##########", METER.bar(100.0D, 10));
            are_equal("..........", METER.bar(0.0D, 10));
        si

        meter__bar__is_always_the_width_asked_for() is
            @test()

            for width in [1, 4, 10, 24] do
                for percent in [0.0D, 33.3D, 50.0D, 99.9D, 100.0D] do
                    are_equal(width, METER.bar(percent, width).length);
                od
            od
        si

        // A percentage outside the range would otherwise produce a bar longer or
        // shorter than its column.
        meter__bar__clamps_a_percentage_outside_the_range() is
            @test()

            are_equal("##########", METER.bar(150.0D, 10));
            are_equal("..........", METER.bar(-10.0D, 10));
        si
    si
si
